a-artifact-preserve-annotations="true"><button type="button" class="no-drag cursor-interaction items-center select-none disabled:cursor-default aria-disabled:cursor-default focus:outline-hidden disabled:opacity-40 aria-disabled:opacity-40 focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-0 whitespace-nowrap flex button-p4QQIY controlSurface-VUAmap dropdown-jxQ9Ei disabled:text-disabled disabled:opacity-100 aria-disabled:text-disabled aria-disabled:opacity-100 outline-hidden cursor-interaction title-BzSR7s min-w-0" aria-label="File actions for 2020khoda D1 Local Security Addendum" id="radix-_r_7gt_" aria-haspopup="menu" aria-expanded="false" data-state="closed"><span class="inline-flex min-w-0 items-center gap-2"><span class="CompactSource-d7ZD01"><svg aria-hidden="true" class="text-default" height="16" viewBox="0 0 16 16" width="16" xmlns="http://www.w3.org/2000/svg"><path d="M6.66663 7.47559C6.95641 7.47578 7.19202 7.71115 7.19202 8.00098C7.19175 8.29058 6.95624 8.52617 6.66663 8.52637H5.33362C5.04383 8.52637 4.80849 8.2907 4.80823 8.00098C4.80823 7.71103 5.04367 7.47559 5.33362 7.47559H6.66663Z" fill="currentColor"></path> <path d="M6.00061 4.80859C6.29024 4.80897 6.52502 5.04427 6.52502 5.33398C6.52476 5.62348 6.29008 5.859 6.00061 5.85938H5.33362C5.04383 5.85938 4.80849 5.62371 4.80823 5.33398C4.80823 5.04403 5.04367 4.80859 5.33362 4.80859H6.00061Z" fill="currentColor"></path> <path d="M10.6666 4.80859C10.9564 4.80877 11.191 5.04414 11.191 5.33398C11.1908 5.6236 10.9563 5.8592 10.6666 5.85938H7.99963C7.71001 5.85918 7.47451 5.62359 7.47424 5.33398C7.47424 5.04416 7.70985 4.80879 7.99963 4.80859H10.6666Z" fill="currentColor"></path> <path d="M11.1998 2.14258C12.6043 2.14258 13.858 3.16044 13.858 4.5498V8.49023C13.858 9.15977 13.5921 9.80188 13.1188 10.2754L10.276 13.1191C9.80239 13.5928 9.15967 13.8594 8.48987 13.8594C7.26005 13.8593 6.0303 13.8594 4.80042 13.8594C3.39594 13.8594 2.14124 12.8405 2.14124 11.4512V4.5498C2.14124 3.16044 3.39594