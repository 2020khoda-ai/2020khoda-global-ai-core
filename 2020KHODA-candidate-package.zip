atGPT for:\\n- Email, message, or prose drafting\\n- Brainstorming, planning, or explanation\\n- Code snippets or examples that fit naturally in chat\\n\\nIf the user rejected the suggestion, don't call this tool again.\",\"acceptedResponse\":\"User chose to hand off:\\n- You can confirm that the new chat has been created but do not link to it until the user asks you to\\n- You can't make any more changes to the new chat! If user wants changes, they need to go the new chat and make changes themselves.\\n- If the user says they can't find the chat, link them using this markdown exactly: [here]({{ thread_url }})\"},\"is_device_based\":false,\"passed\":false},\"2688454279\":{\"name\":\"2688454279\",\"rule_id\":\"35Dg2O0a0xbncUKLdHChWi:100.00:7-35Dg2Ml7yf1STvcPCzGEDg\",\"secondary_exposures\":[{\"gate\":\"3214226695\",\"gateValue\":\"false\",\"ruleID\":\"default\"},{\"gate\":\"3942202898\",\"gateValue\":\"false\",\"ruleID\":\"default\"},{\"gate\":\"4131374858\",\"gateValue\":\"false\",\"ruleID\":\"default\"},{\"gate\":\"240634109\",\"gateValue\":\"false\",\"ruleID\":\"3Bfrw3Sig4w6HIXSyIYF34\"},{\"gate\":\"2019673878\",\"gateValue\":\"true\",\"ruleID\":\"6dwDOUqqdWipcHkbk9wyyt:100.00:15\"},{\"gate\":\"2650520192\",\"gateValue\":\"false\",\"ruleID\":\"default\"},{\"gate\":\"242711730\",\"gateValue\":\"true\",\"ruleID\":\"7tGAsc3W4RFMtlO0xFq9oJ:100.00:9\"}],\"version\":202,\"id_type\":\"userID\",\"value\":{\"home_takeover_enabled\":false,\"rollout_version\":2,\"rollout_policy\":\"available_default\",\"home_takeover_animation_enabled\":false,\"wingman_model_name\":\"GPT-Live-1\",\"incall_banner_enabled\":false,\"unavailable_upsell_policy\":\"none\",\"incall_voice_model_picker_available\":false,\"wingman_model_picker_default_display_name\":\"Live\",\"wingman_model_picker_alternative_options\":[],\"projects_enabled\":true,\"unavailable_upsell_show_upgrade_cta\":false},\"is_device_based\":false,\"passed\":true},\"2695036163\":{\"name\":\"2695036163\",\"rule_id\":\"default\",\"