ser_in_experiment\":false},\"1514783977\":{\"name\":\"1514783977\",\"rule_id\":\"5c7eTqPcr04kHs62StVEE7\",\"secondary_exposures\":[],\"version\":14,\"id_type\":\"userID\",\"value\":{\"show_task\":true},\"is_device_based\":false,\"group_name\":\"Visible\",\"is_experiment_active\":true,\"is_user_in_experiment\":true},\"1546790766\":{\"name\":\"1546790766\",\"rule_id\":\"6so2zzLvnKjM8SVDWwSyz7:100.00:16-6so2zy6sVsahPtnIloWVg5\",\"secondary_exposures\":[{\"gate\":\"2876266821\",\"gateValue\":\"false\",\"ruleID\":\"default\"},{\"gate\":\"324099391\",\"gateValue\":\"true\",\"ruleID\":\"34ViavtVWO2VM8tWIWLFHn:100.00:2\"},{\"gate\":\"1033995237\",\"gateValue\":\"false\",\"ruleID\":\"default\"},{\"gate\":\"225888775\",\"gateValue\":\"true\",\"ruleID\":\"2ONv4iK0mWZmVnlLdmcnFi\"},{\"gate\":\"3539777877\",\"gateValue\":\"false\",\"ruleID\":\"3ICcCprQVlC9NLd66rPMrY:2.50:4\"},{\"gate\":\"2185729796\",\"gateValue\":\"true\",\"ruleID\":\"3y7YsehMeZVWWyBJYUh8z0:100.00:6\"}],\"version\":49,\"id_type\":\"userID\",\"value\":{\"health_v3_starter_prompts_enabled\":true,\"enabled\":true,\"health_v3_tabs\":{\"tab_order\":[\"home\",\"chats\",\"records\",\"accounts\"],\"accounts\":{\"ecosystem_view_slug\":\"connections\",\"visible\":true},\"records\":{\"visible\":true,\"ecosystem_view_slug\":\"recordsTimeline\"},\"home\":{\"ecosystem_view_slug\":\"home\",\"visible\":true},\"chats\":{\"visible\":true}}},\"is_device_based\":false,\"passed\":true},\"1557207450\":{\"name\":\"1557207450\",\"rule_id\":\"32VPyPp1Jc3m46RrYpe2pc\",\"secondary_exposures\":[{\"gate\":\"1192462084\",\"gateValue\":\"false\",\"ruleID\":\"default\"},{\"gate\":\"1506791903\",\"gateValue\":\"false\",\"ruleID\":\"default\"}],\"version\":9,\"id_type\":\"userID\",\"value\":{\"enabled\":true},\"is_device_based\":false,\"is_in_layer\":true,\"explicit_parameters\":[\"enabled\"],\"group_name\":\"Treatment\",\"is_experiment_active\":true,\"is_user_in_experiment\":true},\"1571275116\":{\"name\":\"1571275116\",\"rule_id\":\"default\"