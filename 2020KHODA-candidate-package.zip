8381\":{\"name\":\"3861898381\",\"rule_id\":\"default\",\"secondary_exposures\":[],\"version\":18,\"id_type\":\"userID\",\"value\":{\"max_file_uploads\":20},\"is_device_based\":false,\"passed\":false},\"3927407613\":{\"name\":\"3927407613\",\"rule_id\":\"launchedGroup\",\"secondary_exposures\":[{\"gate\":\"3029657650\",\"gateValue\":\"false\",\"ruleID\":\"default\"},{\"gate\":\"783457649\",\"gateValue\":\"true\",\"ruleID\":\"MwhpGkzNnZ5NLXkuOqIrW\"}],\"version\":25,\"id_type\":\"userID\",\"value\":{\"enabled\":true},\"is_device_based\":false,\"group_name\":\"Treatment\",\"is_experiment_active\":false,\"is_user_in_experiment\":false},\"3934129380\":{\"name\":\"3934129380\",\"rule_id\":\"default\",\"secondary_exposures\":[],\"version\":38,\"id_type\":\"userID\",\"value\":{\"model\":\"gpt-4o\"},\"is_device_based\":false,\"passed\":false},\"3939855767\":{\"name\":\"3939855767\",\"rule_id\":\"default\",\"secondary_exposures\":[],\"version\":6,\"id_type\":\"userID\",\"value\":{\"section_order\":[]},\"is_device_based\":false,\"passed\":false},\"3999280432\":{\"name\":\"3999280432\",\"rule_id\":\"default\",\"secondary_exposures\":[],\"version\":15,\"id_type\":\"userID\",\"value\":{\"url\":\"https://help.openai.com/articles/20001423\"},\"is_device_based\":false,\"passed\":false},\"4023951618\":{\"name\":\"4023951618\",\"rule_id\":\"default\",\"secondary_exposures\":[],\"version\":13,\"id_type\":\"userID\",\"value\":{},\"is_device_based\":false,\"passed\":false},\"4051280260\":{\"name\":\"4051280260\",\"rule_id\":\"4N0Bu9SJLk5QaPucNgS6m8:100.00:6-4N0Bu8dHj1WlRpWhc8Wt36\",\"secondary_exposures\":[{\"gate\":\"3856949927\",\"gateValue\":\"true\",\"ruleID\":\"disabled\"}],\"version\":120,\"id_type\":\"userID\",\"value\":{\"templates\":[{\"id\":\"to-do-list\",\"title\":\"To-do list\",\"previewMarkdown\":\"## Today\\n\\n### Top priorities\\n\\n- [ ] Run propulsion test\\n\\n- [ ] Verify course calculations\\n\\n- [ ] Inspect fuel tanks\\n\\n### If time allows\\n\\n- [ ] Inspect radiation shields\\n\\n- [ ] Test communication systems\\n\\n- [ ] Write status report\",\"prompt\":\"Check my relevant connected apps and create a to-do checklist. Automatically update every morning at 6am in my browser time zone: check off completed tasks for me, and carry forward incomplete tasks to the next day.\",\"prefillPrompt\":\"Help me turn this Page into my to-do list. Check relevant conversations and connected apps you can access for things I need to do. If you can’t find enough, ask me what to add. Replace the sample tasks, keep the checkboxes and any edits I’ve made, and don’t invent tasks or deadlines.\"},{\"previewDocument\":[{\"markdown\":\"## 🔴 Needs immediate attention\",\"kind\":\"markdown\"},{\"kind\":\"markdown\",\"markdown\":\"- Communication systems test for launch\"},{\"markdown\":\"## ⛰️ Milestones\",\"kind\":\"markdown\"},{\"markdown\":\"| Milestone | Status |\\n| - | - |\\n| \u003cul\u003e\u003cli data-checked=\\\"false\\\"\u003e\u003cp\u003eProject brief\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e | Complete |\\n| \u003cul\u003e\u003cli data-checked=\\\"false\\\"\u003e\u003cp\u003ePrototype review\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e | In progress |\\n| \u003cul\u003e\u003cli data-checked=\\\"false\\\"\u003e\u003cp\u003eLaunch readiness\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e | Upcoming |\",\"kind\":\"markdown\",\"layout\":\"flexible\"},{\"markdown\":\"## ✅ Tasks\",\"kind\":\"markdown\"},{\"markdown\":\"| Task | Owner | Status |\\n| - | - | - |\\n| \u003cul\u003e\u003cli data-checked=\\\"false\\\"\u003e\u003cp\u003eConfirm scope\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e | Product | Done |\\n| \u003cul\u003e\u003cli data-checked=\\\"false\\\"\u003e\u003cp\u003eReview designs\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e | Design | In progress |\\n| \u003cul\u003e\u003cli data-checked=\\\"false\\\"\u003e\u003cp\u003eTest the core flow\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e | Engineering | Next |\\n| \u003cul\u003e\u003cli data-checked=\\\"false\\\"\u003e\u003cp\u003ePrepare launch notes\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e | Marketing | Next |\",\"kind\":\"markdown\",\"layout\":\"flexible\"}],\"title\":\"Project tracker\",\"id\":\"project-tracker\",\"prompt\":\"Check my relevant connected apps and create a project tracker. Automatically update every morning at 6am in my browser time zone.\",\"prefillPrompt\":\"Help me make this Page a tracker for my project. Use relevant conversations and connected apps you can access to find milestones and tasks, and ask me for anything missing. Replace the examples, keep my edits, and don’t guess at owners, dates, or statuses.\",\"previewMarkdown\":\"## 🔴 Needs immediate attention\\n\\n- Communication systems test for launch\\n\\n## ⛰️ Milestones\\n\\n| Milestone | Status |\\n| - | - |\\n| \u003cul\u003e\u003cli data-checked=\\\"false\\\"\u003e\u003cp\u003eProject brief\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e | Complete |\\n| \u003cul\u003e\u003cli data-checked=\\\"false\\\"\u003e\u003cp\u003ePrototype review\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e | In progress |\\n| \u003cul\u003e\u003cli data-checked=\\\"false\\\"\u003e\u003cp\u003eLaunch readiness\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e | Upcoming |\\n\\n## ✅ Tasks\\n\\n| Task | Owner | Status |\\n| - | - | - |\\n| \u003cul\u003e\u003cli data-checked=\\\"false\\\"\u003e\u003cp\u003eConfirm scope\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e | Product | Done |\\n| \u003cul\u003e\u003cli data-checked=\\\"false\\\"\u003e\u003cp\u003eReview designs\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e | Design | In progress |\\n| \u003cul\u003e\u003cli data-checked=\\\"false\\\"\u003e\u003cp\u003eTest the core flow\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e | Engineering | Next |\\n| \u003cul\u003e\u003cli data-checked=\\\"false\\\"\u003e\u003cp\u003ePrepare launch notes\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e | Marketing | Next |\"},{\"prompt\":\"Check my relevant connected apps and create a weekly update suitable for sharing with cross-functional partners, stakeholders, and executives.\",\"id\":\"weekly-update\",\"title\":\"Weekly update\",\"prefillPrompt\":\"Help me write this week’s update on this Page. Look for progress, blockers, and next steps in relevant conversations and connected apps you can access. Ask which project or week I mean if it’s unclear, and don’t make up accomplishments.\",\"previewMarkdown\":\"## ✨ Highlights\\n\\n- Progress made\\n\\n## ☝️ Needs attention\\n\\n- Blockers and decisions needing input\\n\\n## ▶️ Next week\\n\\n- Upcoming milestones and confirmed commitments\\n\\n## 🔗 Sources\\n\\n- Links to sources\"},{\"prefillPrompt\":\"Help me organize feedback on this Page. Use relevant conversations and connected apps you can access to find feedback. Ask what product or topic to focus on if it’s unclear, replace the examples with what you find, and don’t invent feedback.\",\"id\":\"feedback-tracker\",\"prompt\":\"Check my relevant connected apps and create a feedback tracker. Ask which project I would like to track feedback for. Automatically update every morning at 6am in my browser time zone.\",\"previewMarkdown\":\"## 🔎 Top themes\\n\\n1. Make onboarding easier to follow\\n\\n2. Help people find the right resource\\n\\n3. Clarify what happens after sharing\\n\\n## 🗂️ Feedback register\\n\\n| Theme | Source | Next step |\\n| - | - | - |\\n| Onboarding | Research notes | Review the first-run flow |\\n| Navigation | Team channel | Group related resources |\\n| Sharing | Support email | Clarify confirmation copy |\\n\\n## 📝 Summary\\n\\nPeople need clearer guidance at key moments. Start with onboarding, then review navigation and sharing.\\n\\n## ▶️ Follow-ups\\n\\n- Schedule user interviews for next week\",\"previewDocument\":[{\"kind\":\"markdown\",\"markdown\":\"## 🔎 Top themes\"},{\"markdown\":\"1. Make onboarding easier to follow\",\"kind\":\"markdown\"},{\"markdown\":\"2. Help people find the right resource\",\"kind\":\"markdown\"},{\"markdown\":\"3. Clarify what happens after sharing\",\"kind\":\"markdown\"},{\"markdown\":\"## 🗂️ Feedback register\",\"kind\":\"markdown\"},{\"markdown\":\"| Theme | Source | Next step |\\n| - | - | - |\\n| Onboarding | Research notes | Review the first-run flow |\\n| Navigation | Team channel | Group related resources |\\n| Sharing | Support email | Clarify confirmation copy |\",\"layout\":\"flexible\",\"kind\":\"markdown\"},{\"markdown\":\"## 📝 Summary\",\"kind\":\"markdown\"},{\"markdown\":\"People need clearer guidance at key moments. Start with onboarding, then review navigation and sharing.\",\"kind\":\"markdown\"},{\"markdown\":\"## ▶️ Follow-ups\",\"kind\":\"markdown\"},{\"kind\":\"markdown\",\"markdown\":\"- Schedule user interviews for next week\"}],\"title\":\"Feedback tracker\"},{\"prompt\":\"Check my relevant connected apps and create release notes. Ask which project I would like to create release notes for.\",\"title\":\"Release notes\",\"id\":\"release-notes\",\"previewMarkdown\":\"## 🆕 New\\n\\n- New capabilities and who can use them\\n\\n## 🏆 Improvements\\n\\n- Changes to existing workflows\\n\\n## 🛠️ Fixes\\n\\n- Resolved issues and their impact\\n\\n## 🌐 Availability\\n\\n- Supported platforms, rollout status, and known limitations.\\n\\n## 🔗 Sources\\n\\n- Links to sources\",\"prefillPrompt\":\"Help me write release notes on this Page. Check relevant conversations and connected apps you can access for confirmed changes and limitations. Ask which release I mean if it’s unclear, and don’t add unconfirmed details or publish anything.\"}],\"targeting\":{\"recommendations\":{\"individual\":[\"to-do-list\",\"project-tracker\",\"trip-planner\",\"weekly-planner\",\"budget-tracker\",\"apartment-hunter\",\"personal-goals\"],\"education\":[\"to-do-list\",\"project-tracker\",\"learning-plan\",\"weekly-planner\",\"personal-goals\"],\"business\":[\"to-do-list\",\"project-tracker\",\"weekly-update\",\"release-notes\",\"feature-backlog\",\"event-plan\"],\"fallback\":[\"to-do-list\",\"project-tracker\",\"weekly-planner\",\"personal-goals\"]},\"templates\":[{\"id\":\"feature-backlog\",\"setupQuestion\":\"Which product is this for? You can paste a few ideas to get started.\",\"prompt\":\"Turn ideas and requests for my product into a feature backlog. Group similar requests, describe the user need, link supporting feedback, and suggest priorities and next decisions. Ask which product if it’s unclear; a few ideas are enough to start. Use the details I’ve shared and relevant conversations and connected apps you can access to fill in this Page. Ask for missing essentials only after checking that context. Update this Page and preserve my edits.\",\"prefillPrompt\":\"Organize a feature backlog for my product, grouping requests by user need and suggesting priorities and next decisions. Use details I’ve shared and relevant conversations and connected apps you can access; ask for what’s missing after checking them. Update this Page and preserve my edits.\",\"previewMarkdown\":\"## Ideas and requests\\n| Idea | User problem | Evidence | Next decision |\\n| --- | --- | --- | --- |\\n\\n## Priorities to discuss\\nCompare impact, effort, and dependencies where known.\\n\\n## Open questions\\nTrack what needs research or a product decision.\",\"title\":\"Feature backlog\"},{\"setupQuestion\":\"What would you like to learn?\",\"previewDocument\":[{\"markdown\":\"**Time:** Two 30-minute sessions a week\",\"kind\":\"markdown\"},{\"kind\":\"markdown\",\"markdown\":\"## 🎯 Outcome\"},{\"markdown\":\"Locate five major lunar features on a map and explain the difference between a crater and a dark plain in ordinary language.\",\"kind\":\"markdown\"},{\"kind\":\"markdown\",\"markdown\":\"## 🧩 Starting point\"},{\"kind\":\"markdown\",\"markdown\":\"I can recognize the Moon’s broad light and dark areas. I want to connect those patterns with named places.\"},{\"kind\":\"markdown\",\"markdown\":\"## 🗺️ Learning path\"},{\"kind\":\"markdown\",\"markdown\":\"| Step | Resource | Practice |\\n| --- | --- | --- |\\n| Get oriented | NASA Moon overview | Label five features on a sketch |\\n| Look closely | A library lunar atlas | Compare two images of one region |\\n| Explain it | My own notes | Write a 100-word visitor caption |\",\"layout\":\"normal\"},{\"kind\":\"markdown\",\"markdown\":\"## 📅 Weekly rhythm\"},{\"markdown\":\"- [ ] Tuesday: read one short section and draw a sketch.\",\"kind\":\"markdown\"},{\"kind\":\"markdown\",\"markdown\":\"- [ ] Sunday: revisit the sketch without looking at the labels.\"},{\"markdown\":\"- [ ] Explain one feature to a friend.\",\"kind\":\"markdown\"},{\"markdown\":\"## 📝 Notebook\",\"kind\":\"markdown\"},{\"kind\":\"markdown\",\"markdown\":\"**Observation:** The same region can look quite different as shadows change.\"},{\"kind\":\"markdown\",\"markdown\":\"**Question:** Which lighting makes a crater’s shape easiest to see?\"},{\"markdown\":\"## 🔁 Progress check\",\"kind\":\"markdown\"},{\"kind\":\"markdown\",\"markdown\":\"I can locate three of the five features without the atlas. Compare those three under different lighting, then add two more and repeat the unlabeled sketch.\"},{\"markdown\":\"## 🔗 Start here\",\"kind\":\"markdown\"},{\"kind\":\"markdown\",\"markdown\":\"[NASA Moon overview](https://science.nasa.gov/moon/)\"}],\"prefillPrompt\":\"Make a learning plan with a clear goal, useful resources, practice, and a weekly routine. Use details I’ve shared and relevant conversations and connected apps you can access; ask for what’s missing after checking them. Replace the examples with my details and preserve my edits.\",\"id\":\"learning-plan\",\"title\":\"Learning plan\",\"prompt\":\"Help me make a plan for something I want to learn. Start with what I already know and what I want to be able to do. Break it into manageable steps with useful resources, practice, and a weekly routine. Include space for notes and progress checks. Use the details I’ve shared and relevant conversations and connected apps you can access to fill in this Page. Ask for missing essentials only after checking that context. Replace the examples with my details and preserve my edits.\"},{\"prefillPrompt\":\"Make a realistic weekly plan around my priorities and commitments, with suggested focus time and room for rest. Use details I’ve shared and relevant conversations and connected apps you can access; ask for what’s missing after checking them. Replace the examples with my details and preserve my edits.\",\"setupQuestion\":\"What do you want to get done this week? Anything already on your calendar?\",\"previewDocument\":[{\"kind\":\"markdown\",\"markdown\":\"## 🎯 Priorities\"},{\"kind\":\"markdown\",\"markdown\":\"- [ ] Finish the lunar exhibit captions.\"},{\"kind\":\"markdown\",\"markdown\":\"- [ ] Confirm volunteer roles for Friday.\"},{\"markdown\":\"- [ ] Leave one evening free of commitments.\",\"kind\":\"markdown\"},{\"kind\":\"markdown\",\"markdown\":\"## 🗓️ Week at a glance\"},{\"layout\":\"normal\",\"kind\":\"markdown\",\"markdown\":\"| Day | Main focus | Commitment |\\n| --- | --- | --- |\\n| Monday | Caption edits | Review with Leo, 14:00 |\\n| Tuesday | Final captions and handout draft | Approve the full print set |\\n| Wednesday | Send approved files to the print shop | Volunteer call, 18:00 |\\n| Thursday | Collect prints and check the room | Free evening |\\n| Friday | Open house | Arrive at 17:15 |\\n| Weekend | Rest and a short walk | Sunday journal time |\"},{\"kind\":\"markdown\",\"markdown\":\"## 🏡 Everyday life\"},{\"markdown\":\"- [ ] Pick up groceries on the way home.\",\"kind\":\"markdown\"},{\"kind\":\"markdown\",\"markdown\":\"- [ ] Return the library book.\"},{\"kind\":\"markdown\",\"markdown\":\"- [ ] Call a friend over the weekend.\"},{\"kind\":\"markdown\",\"markdown\":\"## 📌 Can wait\"},{\"kind\":\"markdown\",\"markdown\":\"The archive’s video section and the future talk schedule.\"},{\"markdown\":\"## ✨ Weekend review\",\"kind\":\"markdown\"},{\"markdown\":\"**What helped:** Did the shared caption review resolve questions before printing?\",\"kind\":\"markdown\"},{\"kind\":\"markdown\",\"markdown\":\"**What to change:** Note any last-minute printing or role changes to allow for in the next event plan.\"}],\"id\":\"weekly-planner\",\"prompt\":\"Plan my week around the priorities and commitments I’ve shared. Create a short priority list and a realistic day-by-day plan with suggested focus time and room for rest. Ask what matters most this week if you need a starting point. Use the details I’ve shared and relevant conversations and connected apps you can access to fill in this Page. Ask for missing essentials only after checking that context. Replace the examples with my details and preserve my edits.\",\"title\":\"Weekly planner\"},{\"prompt\":\"Make a flexible itinerary and planning checklist using the trip details I’ve shared. Include ideas for activities, transport, and accommodation, keeping confirmed bookings easy to identify. Ask where I’d like to go if needed, or help me choose a destination. Use the details I’ve shared and relevant conversations and connected apps you can access to fill in this Page. Ask for missing essentials only after checking that context. Replace the examples with my details and preserve my edits.\",\"id\":\"trip-planner\",\"prefillPrompt\":\"Make a flexible trip itinerary and planning checklist, including activities, transport, and accommodation. Help me choose a destination if needed. Use details I’ve shared and relevant conversations and connected apps you can access; ask for what’s missing after checking them. Replace the examples with my details and preserve my edits.\",\"previewDocument\":[{\"markdown\":\"**Travelers:** Maya and Sam  \\n**Pace:** One main activity a day\",\"kind\":\"markdown\"},{\"kind\":\"markdown\",\"markdown\":\"## 🧭 The plan\"},{\"markdown\":\"Plan two nights near a mountain observatory. The visitor tour is the main activity; confirm its availability before choosing transport and accommodation.\",\"kind\":\"markdown\"},{\"kind\":\"markdown\",\"markdown\":\"## 🚆 Travel and stay\"},{\"layout\":\"normal\",\"kind\":\"markdown\",\"markdown\":\"| Item | Plan | Status |\\n| --- | --- | --- |\\n| Outbound | Friday afternoon train, then local shuttle | Compare departure times |\\n| Accommodation | Two nights in the village | Choose a flexible booking |\\n| Return | Sunday afternoon train | Leave time for lunch |\"},{\"markdown\":\"## 🗓️ Daily outline\",\"kind\":\"markdown\"},{\"kind\":\"markdown\",\"markdown\":\"| Day | Main plan | Flexible alternative |\\n| --- | --- | --- |\\n| Friday | Arrive and settle in | Short village walk |\\n| Saturday | Observatory visitor tour | Science museum if tours change |\\n| Sunday | Easy morning walk | Café and photo journal |\",\"layout\":\"normal\"},{\"markdown\":\"## 🎒 Before leaving\",\"kind\":\"markdown\"},{\"kind\":\"markdown\",\"markdown\":\"- [ ] Check the visitor schedule, reserve the tour if required, and review the weather before departure.\"},{\"kind\":\"markdown\",\"markdown\":\"- [ ] Confirm transport and accommodation.\"},{\"kind\":\"markdown\",\"markdown\":\"- [ ] Save tickets and maps offline.\"},{\"kind\":\"markdown\",\"markdown\":\"- [ ] Pack warm layers, walking shoes, and a notebook.\"},{\"kind\":\"markdown\",\"markdown\":\"## 💡 Useful notes\"},{\"markdown\":\"Use a $450 planning allowance for two people: $300 for two nights, $120 for meals, and $30 for local transport. Intercity tickets and any tour fees are additional; confirm actual prices before booking. Keep skywatching optional.\",\"kind\":\"markdown\"}],\"title\":\"Trip planner\",\"setupQuestion\":\"Where would you like to go—or would you like help choosing?\"},{\"id\":\"budget-tracker\",\"prompt\":\"Use relevant financial information from connected apps you can access to build my budget tracker. Organize income and spending, show how they compare, and help me track progress toward my goals. Use the currency shown in my accounts and start with this month unless I specify otherwise. Keep totals for different currencies separate. Use the details I’ve already shared, and ask for missing essentials only after checking the available information. If no financial information is available, start with an editable budget and ask what I’d like to add. Update this Page and preserve my edits.\",\"setupQuestion\":\"What would you like help with—tracking spending, saving toward a goal, or both?\",\"title\":\"Budget tracker\",\"previewMarkdown\":\"## Budget period\\nAdd the time period and currency.\\n\\n## Planned and actual spending\\n| Category | Planned | Actual | Remaining |\\n| --- | --- | --- | --- |\\n| Housing | | | |\\n| Food | | | |\\n| Transport | | | |\\n\\n## Transactions\\nAdd income and expenses with dates and sources.\\n\\n## Review\\nNote missing figures and changes for next period.\",\"prefillPrompt\":\"Use financial information from connected apps you can access and details I’ve shared to make a budget tracker for this month. Organize income and spending and track my savings goals, using my accounts’ currencies and keeping their totals separate. If no figures are available, help me start an editable budget. Update this Page and preserve my edits.\"},{\"title\":\"Apartment hunter\",\"prompt\":\"Organize my apartment search around my location and rent budget. Compare available listings by rent, fees, availability, and my preferences, with links and next steps. If I haven’t added listings yet, start with search criteria and a comparison table. Use the details I’ve shared and relevant conversations and connected apps you can access to fill in this Page. Ask for missing essentials only after checking that context. Update this Page and preserve my edits.\",\"id\":\"apartment-hunter\",\"prefillPrompt\":\"Help me compare apartments by rent, fees, availability, and my preferences, with listing links and next steps. Use details I’ve shared and relevant conversations and connected apps you can access; ask for what’s missing after checking them. Update this Page and preserve my edits.\",\"setupQuestion\":\"Where are you looking, and what is your rent budget?\",\"previewMarkdown\":\"## Search criteria\\nAdd location, budget, move-in timing, and must-haves.\\n\\n## Shortlist\\n| Listing | Rent and fees | Availability | Notes |\\n| --- | --- | --- | --- |\\n\\n## Next steps\\n- [ ] Save listings to compare\\n- [ ] Prepare questions for a viewing\\n\\n## Viewing notes\\nRecord observations and questions for each apartment.\"},{\"prompt\":\"Make a plan for my event with its purpose, key details, schedule, people involved, and preparation checklist. Include a backup plan and follow-up tasks where useful. Use the details I’ve shared and relevant conversations and connected apps you can access to fill in this Page. Ask for missing essentials only after checking that context. Replace the examples with my details and preserve my edits.\",\"prefillPrompt\":\"Help me plan my event, including the schedule, people involved, preparation, and follow-up. Use the details I’ve shared and relevant conversations and connected apps you can access to fill in this Page. Ask for missing essentials only after checking that context. Replace the examples with my details and preserve my edits.\",\"previewDocument\":[{\"kind\":\"markdown\",\"markdown\":\"**Time:** 18:00–20:00 local time  \\n**Place:** Northfield Observatory visitor hall  \\n**Lead:** Sam Rivera\"},{\"kind\":\"markdown\",\"markdown\":\"## 🌙 Purpose\"},{\"markdown\":\"An informal evening of lunar images, short talks, and questions for first-time visitors.\",\"kind\":\"markdown\"},{\"markdown\":\"## 📋 Essentials\",\"kind\":\"markdown\"},{\"layout\":\"normal\",\"kind\":\"markdown\",\"markdown\":\"| Item | Plan |\\n| --- | --- |\\n| Capacity | 40 visitors |\\n| Planning budget | $300 total: $100 printing and $200 refreshments |\\n| Access | Step-free entrance, seating, large-print handouts |\\n| Main contact | Sam at the welcome desk |\"},{\"kind\":\"markdown\",\"markdown\":\"## 🕰️ Run of show\"},{\"markdown\":\"| Time | Activity | Lead |\\n| --- | --- | --- |\\n| 17:15 | Set up and volunteer briefing | Sam |\\n| 18:00 | Welcome and image gallery | Maya |\\n| 18:30 | A short tour of the lunar landscape | Priya |\\n| 19:00 | Indoor questions; outdoor viewing if conditions allow | Priya |\\n| 20:00 | Close and reset the room | Team |\",\"layout\":\"normal\",\"kind\":\"markdown\"},{\"kind\":\"markdown\",\"markdown\":\"## ✅ Preparation\"},{\"markdown\":\"- [ ] Sam: confirm the room layout and step-free visitor route.\",\"kind\":\"markdown\"},{\"kind\":\"markdown\",\"markdown\":\"- [ ] Maya: print 50 handouts and the caption cards before the room check.\"},{\"kind\":\"markdown\",\"markdown\":\"- [ ] Priya: confirm the observing setup and brief volunteers on the indoor alternative.\"},{\"kind\":\"markdown\",\"markdown\":\"## ☁️ If plans change\"},{\"kind\":\"markdown\",\"markdown\":\"At 16:00, Sam confirms whether outdoor viewing will run. The indoor event goes ahead either way. Sam updates the welcome desk and guest message; if viewing is cancelled, Priya extends the indoor questions and image discussion.\"},{\"kind\":\"markdown\",\"markdown\":\"## 📝 Afterwards\"},{\"kind\":\"markdown\",\"markdown\":\"- [ ] Gather short visitor comments.\"},{\"markdown\":\"- [ ] Record useful changes for the next event.\",\"kind\":\"markdown\"}],\"title\":\"Event Plan\",\"setupQuestion\":\"What event are you planning?\",\"id\":\"event-plan\"},{\"id\":\"personal-goals\",\"setupQuestion\":\"What would you like to work toward?\",\"title\":\"Personal goals\",\"prompt\":\"Help me turn the goals I care about into a practical plan. Capture why each goal matters, what progress would look like, and a few steps I can take this week. Suggest ways to make time for them and include a short review section. Use the details I’ve shared and relevant conversations and connected apps you can access to fill in this Page. Ask for missing essentials only after checking that context. Replace the examples with my details and preserve my edits.\",\"prefillPrompt\":\"Help me make a plan for my personal goals, with signs of progress, a few steps for this week, and time to review how it’s going. Use the details I’ve shared and relevant conversations and connected apps you can access to fill in this Page. Ask for missing essentials only after checking that context. Replace the examples with my details and preserve my edits.\",\"previewDocument\":[{\"kind\":\"markdown\",\"markdown\":\"**Review:** Last Sunday of each month\"},{\"kind\":\"markdown\",\"markdown\":\"## 🧭 What matters\"},{\"markdown\":\"Over the next twelve weeks, learn a few lunar features, finish a photo journal, and keep one evening a week free.\",\"kind\":\"markdown\"},{\"kind\":\"markdown\",\"markdown\":\"## 🎯 Goals\"},{\"kind\":\"markdown\",\"markdown\":\"| Goal | Why | A useful sign of progress |\\n| --- | --- | --- |\\n| Learn the lunar landscape | Make skywatching more rewarding | Recognize five named features |\\n| Make a small photo journal | Finish something tangible | Twelve images with captions |\\n| Protect unplanned time | Leave room to rest | One free evening each week |\",\"layout\":\"normal\"},{\"kind\":\"markdown\",\"markdown\":\"## 👣 This week\"},{\"markdown\":\"- [ ] Borrow a Moon guide from the library.\",\"kind\":\"markdown\"},{\"markdown\":\"- [ ] Choose the first three journal images.\",\"kind\":\"markdown\"},{\"kind\":\"markdown\",\"markdown\":\"- [ ] Keep Thursday evening free.\"},{\"markdown\":\"## 🗓️ Make room\",\"kind\":\"markdown\"},{\"markdown\":\"Reserve half an hour on Sunday for the journal. Join one astronomy-club evening each month. Pause the second online course until the next review.\",\"kind\":\"markdown\"},{\"kind\":\"markdown\",\"markdown\":\"## 🔁 Monthly review\"},{\"markdown\":\"**Progress:** The journal theme is chosen and twelve images are shortlisted.\",\"kind\":\"markdown\"},{\"markdown\":\"**Lesson:** Short sessions are easier to keep than a whole afternoon.\",\"kind\":\"markdown\"},{\"markdown\":\"**Adjustment:** Finish one caption each week so all twelve images are ready by the end of this plan.\",\"kind\":\"markdown\"}]}]}},\"is_device_based\":false,\"passed\":true},\"4059756625\":{\"name\":\"4059756625\",\"rule_id\":\"default\",\"secondary_exposures\":[],\"version\":6,\"id_type\":\"userID\",\"value\":{},\"is_device_based\":false,\"passed\":false},\"4082596618\":{\"name\":\"4082596618\",\"rule_id\":\"default\",\"secondary_exposures\":[],\"version\":33,\"id_type\":\"userID\",\"value\":{\"bio_trusted_access_link\":\"https://chatgpt.com/r/b749fb02595e04c3007a54375f3f4374\",\"cyber_trusted_access_link\":\"https://openai.com/form/enterprise-trusted-access-for-cyber/\"},\"is_device_based\":false,\"passed\":false},\"4168530037\":{\"name\":\"4168530037\",\"rule_id\":\"default\",\"secondary_exposures\":[],\"version\":5,\"id_type\":\"userID\",\"value\":{\"url\":\"https://developers.openai.com/codex/app/chrome-extension\"},\"is_device_based\":false,\"passed\":false},\"4223250888\":{\"name\":\"4223250888\",\"rule_id\":\"xWoWsN1dTTh32fjmQjyTx\",\"secondary_exposures\":[],\"version\":12,\"id_type\":\"userID\",\"value\":{\"enabled\":true},\"is_device_based\":false,\"group_name\":\"Treatment\",\"is_experiment_active\":true,\"is_user_in_experiment\":true},\"4227172377\":{\"name\":\"4227172377\",\"rule_id\":\"default\",\"secondary_exposures\":[{\"gate\":\"3640552975\",\"gateValue\":\"false\",\"ruleID\":\"default\"}],\"version\":5,\"id_type\":\"userID\",\"value\":{\"plus_pricing_default_tab\":\"business\",\"plus_pricing_page_surface\":\"unified\"},\"is_device_based\":false,\"passed\":false},\"4277823746\":{\"name\":\"4277823746\",\"rule_id\":\"default\",\"secondary_exposures\":[],\"version\":8,\"id_type\":\"userID\",\"value\":{\"domains\":[],\"url_patterns\":[\"^https://meet\\\\.google\\\\.com/[a-z]{3}-[a-z]{4}-[a-z