08\":{\"name\":\"4290031608\",\"rule_id\":\"default\",\"secondary_exposures\":[],\"version\":80,\"id_type\":\"userID\",\"value\":false}},\"dynamic_configs\":{\"24353602\":{\"name\":\"24353602\",\"rule_id\":\"default\",\"secondary_exposures\":[],\"version\":28,\"id_type\":\"userID\",\"value\":{\"en\":{\"default\":{\"headline\":\"Explore ChatGPT Business\",\"body\":\"Learn about ad credits for eligible workspaces.\"},\"workspace\":{\"body\":\"A workspace owner can check Benefits for available offers.\",\"headline\":\"Explore workspace ad credits\"},\"workspace_member\":{\"body\":\"If your workspace is eligible, an owner can claim ad credits in Benefits. To set up a separate Business workspace, select Continue.\",\"headline\":\"ChatGPT Business\"},\"workspace_admin\":{\"headline\":\"Help your team find ad credits\",\"body\":\"Ask a workspace owner to check Benefits for the ad credit offer.\"},\"personal_upsell\":{\"headline\":\"Bring your team to Business\",\"body\":\"Explore ChatGPT Business and the ad credit offer for eligible workspaces.\"},\"business_claim\":{\"headline\":\"Explore workspace ad credits\",\"body\":\"Sign in to the account you use for your Business workspace.\"},\"workspace_owner\":{\"headline\":\"Check your workspace benefits\",\"body\":\"Open Benefits to see whether your workspace is eligible for ad credits.\"},\"personal\":{\"headline\":\"Bring your team to Business\",\"body\":\"Explore the offer for your team. Already use Business? Switch to your workspace.\"}},\"de\":{\"workspace_member\":{\"body\":\"Wenn dein Workspace berechtigt ist, kann ein Workspace-Inhaber unter „Vorteile“ Werbeguthaben anfordern. Wähle „Weiter“, um einen separaten Business-Workspace einzurichten.\",\"headline\":\"ChatGPT Business\"},\"workspace\":{\"body\":\"Workspace-Inhaber können unter „Vorteile“ nach verfügbaren Angeboten sehen.\",\"headline\":\"Entdecke Werbeguthaben für deinen Workspace\"},\"workspace_owner\":{\"headline\":\"Prüfe die Vorteile deines Workspaces\",\"body\":\"Öffne „Vorteile“, um zu prüfen, ob dein Workspace für Werbeguthaben berechtigt ist.\"},\"business_claim\":{\"headline\":\"Entdecke Werbeguthaben für deinen Workspace\",\"body\":\"Melde dich mit dem Konto an, das du für deinen Business-Workspace verwendest.\"},\"personal_upsell\":{\"body\":\"Entdecke ChatGPT Business und das Angebot für Werbeguthaben für berechtigte Workspaces.\",\"headline\":\"Wechsle mit deinem Team zu ChatGPT Business\"},\"default\":{\"headline\":\"Entdecke ChatGPT Business\",\"body\":\"Erfahre mehr über Werbeguthaben für berechtigte Workspaces.\"},\"workspace_admin\":{\"headline\":\"Hilf deinem Team, Werbeguthaben zu finden\",\"body\":\"Bitte einen Workspace-Inhaber, unter „Vorteile“ nach dem Angebot für Werbeguthaben zu sehen.\"},\"personal\":{\"headline\":\"Wechsle mit deinem Team zu ChatGPT Business\",\"body\":\"Entdecke das Angebot für dein Team. Nutzt du ChatGPT Business bereits? Wechsle zu deinem Workspace.\"}},\"email_selectors\":{\"parameter\":\"for\",\"personal_upsell\":\"personal\",\"business_claim\":\"workspace\"},\"fr\":{\"personal\":{\"headline\":\"Passez à ChatGPT Business avec votre équipe\",\"body\":\"Découvrez l’offre pour votre équipe. Vous utilisez déjà ChatGPT Business ? Accédez à votre espace de travail.\"},\"default\":{\"headline\":\"Découvrez ChatGPT Business\",\"body\":\"En savoir plus sur les crédits publicitaires destinés aux espaces de travail éligibles.\"},\"personal_upsell\":{\"body\":\"Découvrez ChatGPT Business et l’offre de crédits publicitaires destinée aux espaces de travail éligibles.\",\"headline\":\"Passez à ChatGPT Business avec votre équipe\"},\"business_claim\":{\"headline\":\"Découvrez les crédits publicitaires pour votre espace de travail\",\"body\":\"Connectez-vous au compte que vous utilisez pour votre espace de travail Business.\"},\"workspace_member\":{\"body\":\"Si votre espace de travail est éligible, un propriétaire peut demander des crédits publicitaires dans la rubrique « Avantages ». Pour créer un espace de travail Business distinct, sélectionnez « Continuer ».\",\"headline\":\"ChatGPT Business\"},\"workspace\":{\"headline\":\"Découvrez les crédits publicitaires pour votre espace de travail\",\"body\":\"Un propriétaire de l’espace de travail peut consulter les offres disponibles dans la rubrique « Avantages ».\"},\"workspace_admin\":{\"body\":\"Demandez à un propriétaire de l’espace de travail de consulter l’offre de crédits publicitaires dans la rubrique « Avantages ».\",\"headline\":\"Aidez votre équipe à trouver des crédits publicitaires\"},\"workspace_owner\":{\"headline\":\"Consultez les avantages de votre espace de travail\",\"body\":\"Ouvrez la rubrique « Avantages » pour voir si votre espace de travail est éligible aux crédits publicitaires.\"}}},\"is_device_based\":false,\"passed\":false},\"43735283\":{\"name\":\"43735283\",\"rule_id\":\"default\",\"secondary_exposures\":[{\"gate\":\"4076966226\",\"gateValue\":\"true\",\"ruleID\":\"3Qrg0sazMu3KFYQ5vbybKp:100.00:12\"}],\"version\":33,\"id_type\":\"userID\",\"value\":{\"text_messaging_enabled\":\"disabled\",\"sentinel_timeout_ms\":250},\"is_device_based\":false,\"passed\":false},\"71832722\":{\"name\":\"71832722\",\"rule_id\":\"default\",\"secondary_exposures\":[],\"version\":4,\"id_type\":\"userID\",\"value\":{\"url\":\"https://developers.openai.com/codex/concepts/sandboxing\"},\"is_device_based\":false,\"passed\":false},\"73506792\":{\"name\":\"73506792\",\"rule_id\":\"default\",\"secondary_exposures\":[],\"version\":36,\"id_type\":\"userID\",\"value\":{\"max_archive_admission_bytes\":817889280,\"max_archive_read_bytes\":838860800,\"max_file_bytes\":268435456,\"max_skill_bundle_read_bytes\":838860800,\"max_skill_upload_bytes\":817889280,\"max_skill_total_uncompressed_bytes\":838860800,\"max_skill_file_uncompressed_bytes\":268435456},\"is_device_based\":false,\"passed\":false},\"107580212\":{\"name\":\"107580212\",\"rule_id\":\"7trR3I8WKjmHUC9cbPaof:100.00:9-7trR236us9Sov4dB3Tx5d\",\"secon