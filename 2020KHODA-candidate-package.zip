rsion\":11,\"id_type\":\"userID\",\"value\":{\"templates\":[{\"title\":\"Product Strategy\",\"revision\":\"c98a598ca5cbf03c29c276219182769ab676c32033bde9db71dd2c205624d721\",\"publisher\":\"openai\",\"id\":\"product-strategy\",\"thumbnailUrl\":\"https://persistent.oaistatic.com/space-presentation-templates/product-strategy/c98a598ca5cbf03c29c276219182769ab676c32033bde9db71dd2c205624d721/cover.png\",\"source\":{\"sha256\":\"752ddf9ebb318c4a11e37373dbf053e6450336b9ed45a62eacf4d042f51c6eae\",\"byteLength\":410320,\"url\":\"https://persistent.oaistatic.com/space-presentation-templates/product-strategy/c98a598ca5cbf03c29c276219182769ab676c32033bde9db71dd2c205624d721/presentation.pb\",\"format\":\"presentation-protobuf\"}},{\"title\":\"Weekly Business Review\",\"publisher\":\"openai\",\"source\":{\"byteLength\":245283,\"url\":\"https://persistent.oaistatic.com/space-presentation-templates/weekly-business-review/28b9e7ae1f36383f5b9079f13744a190972ddb1c6266663789584d53c37dc750/presentation.pb\",\"format\":\"presentation-protobuf\",\"sha256\":\"205ca471d698cf2b4037cd9bedadabb7e8eabc87c130e4769b0a81257408c03e\"},\"revision\":\"28b9e7ae1f36383f5b9079f13744a190972ddb1c6266663789584d53c37dc750\",\"thumbnailUrl\":\"https://persistent.oaistatic.com/space-presentation-templates/weekly-business-review/28b9e7ae1f36383f5b9079f13744a190972ddb1c6266663789584d53c37dc750/cover.png\",\"id\":\"weekly-business-review\"},{\"id\":\"photography-portfolio\",\"revision\":\"5d8abc9c361cd00c938b1b18aaf8ec2f731afea409eb23a17b823cdca6d1111e\",\"source\":{\"format\":\"presentation-protobuf\",\"url\":\"https://persistent.oaistatic.com/space-presentation-templates/photography-portfolio/5d8abc9c361cd00c938b1b18aaf8ec2f731afea409eb23a17b823cdca6d1111e/presentation.pb\",\"sha256\":\"b4b228b4ed45654348513b40a2a41a16612fedc1ce0d0317379a34e22813149c\",\"byteLength\":2841567},\"title\":\"Photography Portfolio\",\"thumbnailUrl\":\"https://persistent.oaistatic.com/space-presentation-templates/photography-portfol